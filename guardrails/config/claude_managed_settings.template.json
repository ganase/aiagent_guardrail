{
    "permissions":  {
                        "deny":  [
                                     "Read(./.env)",
                                     "Read(./.env.*)",
                                     "Read(./secrets/**)",
                                     "Read(**/*.pem)",
                                     "Read(**/*.key)",
                                     "Bash(curl * | sh)",
                                     "Bash(curl * | bash)",
                                     "Bash(wget * | sh)",
                                     "Bash(wget * | bash)",
                                     "Bash(powershell -enc *)",
                                     "Bash(powershell -encodedcommand *)"
                                 ],
                        "ask":  [
                                    "Bash(git push *)",
                                    "Bash(git tag *)",
                                    "Bash(npm publish *)"
                                ]
                    },
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"%AIAGENT_GUARDRAIL_HOME%\\hooks\\run_guardrail_hook.cmd\""
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Read",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"%AIAGENT_GUARDRAIL_HOME%\\hooks\\run_guardrail_hook.cmd\""
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Edit",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"%AIAGENT_GUARDRAIL_HOME%\\hooks\\run_guardrail_hook.cmd\""
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Write",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"%AIAGENT_GUARDRAIL_HOME%\\hooks\\run_guardrail_hook.cmd\""
                                                       }
                                                   ]
                                     }
                                 ],
                  "UserPromptSubmit":  [
                                           {
                                               "hooks":  [
                                                             {
                                                                 "type":  "command",
                                                                 "command":  "\"%AIAGENT_GUARDRAIL_HOME%\\hooks\\run_guardrail_hook.cmd\""
                                                             }
                                                         ]
                                           },
                                           {
                                               "hooks":  [
                                                             {
                                                                 "command":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%AIAGENT_GUARDRAIL_HOME%\\\\hooks\\\\record_ai_turn.ps1\" -Tool ClaudeCode",
                                                                 "type":  "command"
                                                             }
                                                         ]
                                           }
                                       ],
                  "PostToolUse":  [
                                      {
                                          "hooks":  [
                                                        {
                                                            "type":  "command",
                                                            "command":  "\"%AIAGENT_GUARDRAIL_HOME%\\hooks\\run_guardrail_hook.cmd\""
                                                        }
                                                    ]
                                      }
                                  ],
                  "Stop":  [
                               {
                                   "hooks":  [
                                                 {
                                                     "command":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%AIAGENT_GUARDRAIL_HOME%\\\\hooks\\\\record_ai_turn.ps1\" -Tool ClaudeCode",
                                                     "type":  "command"
                                                 }
                                             ]
                               }
                           ],
                  "PermissionRequest":  [
                                            {
                                                "hooks":  [
                                                              {
                                                                  "command":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%AIAGENT_GUARDRAIL_HOME%\\\\hooks\\\\approve_safe_request.ps1\" -Tool ClaudeCode",
                                                                  "type":  "command"
                                                              }
                                                          ],
                                                "matcher":  "Bash"
                                            },
                                            {
                                                "hooks":  [
                                                              {
                                                                  "command":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%AIAGENT_GUARDRAIL_HOME%\\\\hooks\\\\approve_safe_request.ps1\" -Tool ClaudeCode",
                                                                  "type":  "command"
                                                              }
                                                          ],
                                                "matcher":  "Read|Glob|Grep"
                                            }
                                        ]
              },
    "allowedMcpServers":  [

                          ],
    "allowManagedMcpServersOnly":  true,
    "allowManagedPermissionRulesOnly":  true,
    "allowedHttpHookUrls":  [

                            ]
}
